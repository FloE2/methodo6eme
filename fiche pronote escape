<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Fiche professeur – Escape games PRONOTE 6B</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&family=Kalam:wght@700&display=swap" rel="stylesheet">
<style>
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
--paper:#FFFFFF;--line:#E4E0F5;--line2:#C7BFEA;--red:#C8322E;--ink:#1F3FAE;--text:#24263A;--muted:#5D6078;--soft:#F6F4FC}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){--paper:#1C2622;--line:#26332E;--line2:#3A4C44;--red:#F07A70;--ink:#9FB4FF;--text:#ECEFEA;--muted:#A9B3AD;--soft:#24302B}}
:root[data-theme="dark"]{--paper:#1C2622;--line:#26332E;--line2:#3A4C44;--red:#F07A70;--ink:#9FB4FF;--text:#ECEFEA;--muted:#A9B3AD;--soft:#24302B}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*,*::before,*::after{box-sizing:inherit}
body{margin:0;background:var(--paper);color:var(--text);font-family:"Atkinson Hyperlegible",Verdana,Arial,sans-serif;line-height:1.55;
background-image:repeating-linear-gradient(0deg,var(--line) 0 1px,transparent 1px 32px)}
.wrap{max-width:52rem;margin:0 auto;padding:1.5rem 1rem 3rem}
h1,h2{font-family:"Kalam","Comic Sans MS",cursive;color:var(--red);line-height:1.15}
h1{font-size:clamp(1.8rem,5vw,2.5rem);margin:.4rem 0}
h2{font-size:1.5rem;margin:2rem 0 .5rem;border-bottom:2px solid var(--red);padding-bottom:.2rem}
.lock{max-width:24rem;margin:3rem auto;padding:1.4rem;border:2px solid var(--line2);border-radius:12px;background:var(--paper)}
.lock[hidden],#content[hidden]{display:none}
input{width:100%;font:inherit;padding:.6rem .7rem;border:2px solid var(--line2);border-radius:8px;background:var(--paper);color:var(--text);margin:.6rem 0}
button{font:inherit;font-weight:700;padding:.55rem 1rem;border-radius:8px;border:2px solid var(--red);background:var(--red);color:var(--paper);cursor:pointer}
button.ghost{background:transparent;color:var(--red)}
button:focus-visible,input:focus-visible{outline:3px solid var(--ink);outline-offset:2px}
.err{color:var(--red);font-weight:700;min-height:1.4rem}
.scroll{overflow-x:auto}
table{border-collapse:collapse;width:100%;min-width:36rem;background:var(--paper)}
th,td{border:1px solid var(--line2);padding:.5rem .6rem;text-align:left;vertical-align:top}
th{background:var(--soft)}
td strong{color:var(--red);font-size:1.05rem}
.lt{display:block;color:var(--muted);font-size:.85rem}
.note{color:var(--muted);font-size:.92rem}
.final{font-size:1.15rem}
.check li{margin:.25rem 0}
.top{display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap}
h3{font-family:"Kalam","Comic Sans MS",cursive;color:var(--ink);font-size:1.2rem;margin:1.2rem 0 .3rem}
.say{border-left:4px solid var(--ink);background:var(--soft);padding:.5rem .8rem;border-radius:0 8px 8px 0;font-style:italic}
.toc{display:flex;flex-wrap:wrap;gap:.4rem 1rem;margin:.8rem 0 0}
.toc a{color:var(--ink);font-weight:700}
@media print{body{background:none}.noprint{display:none}h2{break-after:avoid}table{min-width:0}}
</style>
</head>
<body>
<main class="wrap">
  <div class="lock" id="lock">
    <h1>Fiche professeur</h1>
    <p>Cette fiche contient les réponses des escape games PRONOTE de la 6B.</p>
    <label for="pw">Mot de passe</label>
    <input type="password" id="pw" autocomplete="current-password">
    <button id="go">Ouvrir la fiche</button>
    <p class="err" id="err" role="alert"></p>
  </div>
  <div id="content" hidden>
    <div class="top">
      <h1>Fiche professeur – Escape games PRONOTE 6B</h1>
      <span class="noprint"><button class="ghost" onclick="window.print()">Imprimer</button> <button class="ghost" id="lockBtn">Verrouiller</button></span>
    </div>
    <div id="body"></div>
  </div>
</main>
<script>
const DATA = {"s": "TUlLbfVzzn47OmFlyE3UOQ==", "i": "kkv+p0X1nAXVbZjX", "c": ""};
const b64 = s => Uint8Array.from(atob(s), c => c.charCodeAt(0));
async function unlock(pw){
  const base = await crypto.subtle.importKey("raw", new TextEncoder().encode(pw), "PBKDF2", false, ["deriveKey"]);
  const key = await crypto.subtle.deriveKey({name:"PBKDF2", salt:b64(DATA.s), iterations:250000, hash:"SHA-256"}, base, {name:"AES-GCM", length:256}, false, ["decrypt"]);
  const pt = await crypto.subtle.decrypt({name:"AES-GCM", iv:b64(DATA.i)}, key, b64(DATA.c));
  return new TextDecoder().decode(pt);
}
async function go(){
  const err = document.getElementById("err"); err.textContent = "";
  const pw = document.getElementById("pw").value;
  if(!pw){ err.textContent = "Saisissez le mot de passe."; return; }
  try{
    const html = await unlock(pw);
    document.getElementById("body").innerHTML = html;
    document.getElementById("lock").hidden = true;
    document.getElementById("content").hidden = false;
  }catch(e){ err.textContent = "Mot de passe incorrect. Attention aux majuscules."; }
}
document.getElementById("go").addEventListener("click", go);
document.getElementById("pw").addEventListener("keydown", e => { if(e.key==="Enter") go(); });
document.getElementById("lockBtn").addEventListener("click", () => {
  document.getElementById("body").innerHTML = ""; document.getElementById("pw").value = "";
  document.getElementById("content").hidden = true; document.getElementById("lock").hidden = false;
});
</script>
</body>
</html>
